{
  "name": "@esmii/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "build": "next build",
    "build:operator-cli": "esbuild scripts/operator-auth.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/operator-auth.mjs --log-level=warning",
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "operator:migrate": "node --experimental-strip-types scripts/operator-auth.ts migrate",
    "operator:provision": "node --experimental-strip-types scripts/operator-auth.ts provision",
    "operator:recover": "node --experimental-strip-types scripts/operator-auth.ts recover",
    "operator:retarget": "node --experimental-strip-types scripts/operator-auth.ts retarget",
    "operator:revoke-sessions": "node --experimental-strip-types scripts/operator-auth.ts revoke-sessions"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "next": "16.3.3",
    "nodemailer": "9.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
