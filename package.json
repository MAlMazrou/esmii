{
  "name": "@esmii/root",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-toolchain.mjs",
    "commitlint": "node scripts/commitlint-ci.mjs",
    "dev:prepare": "node scripts/development-environment.mjs prepare",
    "dev:reset": "node scripts/development-environment.mjs reset",
    "dev": "pnpm dev:prepare && node scripts/compose.mjs up",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tests.json",
    "test": "pnpm -r --if-present test && vitest run tests/unit tests/policy",
    "test:auth": "pnpm --filter @esmii/server exec vitest run tests/auth-core.test.ts tests/auth-fastify.test.ts tests/account-routes.test.ts",
    "test:organizations": "pnpm --filter @esmii/server exec vitest run tests/account-service.test.ts tests/account-routes.test.ts",
    "test:authorization": "pnpm --filter @esmii/server exec vitest run tests/domain.test.ts tests/account-service.test.ts",
    "test:worker": "pnpm --filter @esmii/server exec vitest run tests/worker.test.ts tests/pg-boss.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:runtime-config": "vitest run tests/runtime",
    "db:migrate": "pnpm dev:prepare && node scripts/compose.mjs migrate",
    "db:migrate:test": "pnpm dev:prepare && node scripts/migration-test.mjs",
    "infra:config": "pnpm dev:prepare && node scripts/compose.mjs config",
    "infra:up": "pnpm dev:prepare && node scripts/compose.mjs up",
    "infra:down": "node scripts/compose.mjs down",
    "infra:validate-templates": "node scripts/infra.mjs validate-templates",
    "infra:test-render": "node scripts/infra.mjs render",
    "infra:test-caddy": "node scripts/infra.mjs caddy",
    "infra:build-shared-payload": "node scripts/infra.mjs build-payload",
    "infra:verify-shared-payload": "node scripts/infra.mjs verify-payload",
    "release:build-application-payload": "node scripts/application-payload.mjs",
    "release:build-staging-manifest": "node scripts/staging-manifest.mjs",
    "release:build-staging-bundle": "node scripts/staging-release-bundle.mjs",
    "release:prepare": "node scripts/release-version.mjs",
    "version:print": "node scripts/app-version.mjs",
    "version:verify": "node scripts/app-version.mjs verify",
    "test:e2e": "playwright test",
    "test:infra": "vitest run tests/infra",
    "test:security": "vitest run tests/infra/security.test.mjs",
    "test:host-compose": "vitest run tests/infra/host-compose.test.mjs",
    "test:release-installer": "vitest run tests/infra/release-installer.test.mjs",
    "test:deployment-reconciler": "vitest run tests/infra/deployment-reconciler.test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:policy": "vitest run tests/policy",
    "image:build": "node scripts/images.mjs build",
    "image:scan": "node scripts/images.mjs scan",
    "image:runtime-fixtures": "node scripts/images.mjs runtime-fixtures",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:runtime-config && pnpm scan:secrets && pnpm test:policy && pnpm test:infra && pnpm infra:validate-templates && pnpm infra:verify-shared-payload && pnpm infra:config"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "commit-and-tag-version": "13.1.2",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
