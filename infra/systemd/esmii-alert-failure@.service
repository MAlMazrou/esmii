[Unit]
Description=Esmii external failure alert for %i

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/empty
ExecStart=/usr/local/libexec/esmii/esmii-alert-failure %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/myapp
TimeoutStartSec=30
