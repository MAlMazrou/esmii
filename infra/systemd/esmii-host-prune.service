[Unit]
Description=Esmii bounded host-only Docker and log prune
After=docker.service systemd-tmpfiles-setup.service
OnFailure=esmii-alert-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/empty
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Environment=DOCKER_CONTEXT=default
ExecStart=/usr/local/libexec/esmii/esmii_host_control.py prune
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/myapp /srv/myapp/releases /var/lib/esmii
ReadWritePaths=/run/lock/esmii /var/lib/docker
TimeoutStartSec=30min
