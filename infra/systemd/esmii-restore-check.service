[Unit]
Description=Esmii isolated weekly restore verification
After=docker.service systemd-tmpfiles-setup.service
OnFailure=esmii-alert-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/empty
ExecStart=/usr/local/libexec/esmii/esmii-restore-check
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/myapp /srv/myapp/releases
ReadWritePaths=/srv/myapp/production/backup-staging /var/lib/esmii/operations /run/lock/esmii
TimeoutStartSec=3h
